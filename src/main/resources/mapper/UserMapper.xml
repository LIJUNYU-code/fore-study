<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.myproject.mapper.UserMapper">


    <!-- 根据用户名查询用户 -->
    <select id="selectByUserName" resultType="org.myproject.entity.User" parameterType="java.lang.String">
        select * from t_user where username = #{username} and deleted = 0
    </select>
    <!-- 根据手机号查询用户 -->
    <select id="selectByPhone" resultType="org.myproject.entity.User" parameterType="java.lang.String">
        select * from t_user where phone = #{phone} and deleted = 0
    </select>
    <!-- 根据用户ID查询用户 -->
    <select id="selectById" resultType="org.myproject.entity.User" parameterType="java.lang.Long">
        select * from t_user where id = #{id} and deleted = 0
    </select>

</mapper>